#include <windows.h>

// Application Icon
1 ICON "../app.ico"

// Application Manifest (1 = RT_MANIFEST)
1 24 "app.manifest"

// Version Information (PE Header metadata)
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,4,1,0
PRODUCTVERSION  1,4,1,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Dust Studio\0"
            VALUE "FileDescription",  "DustFX GPU & DCCW Display Optimizer\0"
            VALUE "FileVersion",      "1.4.1.0\0"
            VALUE "InternalName",     "DustFX.exe\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Dust Studio. All rights reserved.\0"
            VALUE "OriginalFilename", "DustFX.exe\0"
            VALUE "ProductName",      "DustFX\0"
            VALUE "ProductVersion",   "1.4.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
